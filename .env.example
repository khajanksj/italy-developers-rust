HOST=0.0.0.0
PORT=8080
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=italy_developers
# Generate with: openssl rand -base64 64
APP_SECRET_KEY=replace-with-at-least-64-random-bytes-never-commit-real-secrets
COOKIE_SECURE=false
PUBLIC_URL=http://localhost:8080
UPLOAD_DIR=uploads
WEB_WORKERS=2
RUST_LOG=info,actix_web=info
# Optional: path to a MaxMind GeoLite2-Country.mmdb file for IP-based locale
# detection when Cloudflare's CF-IPCountry header isn't present (e.g. local
# dev). Get a free license key at maxmind.com. Leave unset to skip MaxMind
# lookups entirely — Cloudflare's header and Accept-Language still work.
# GEOIP_DB_PATH=/path/to/GeoLite2-Country.mmdb
