HOST=0.0.0.0
PORT=8080
MONGODB_URI=mongodb://italy:change-me@localhost:27017/italy_developers?authSource=admin
MONGODB_DB=italy_developers
# Generate with: openssl rand -base64 64
APP_SECRET_KEY=replace-with-at-least-64-random-bytes-never-commit-real-secrets
COOKIE_SECURE=false
# Used only to bootstrap the first admin account when the admins collection is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-local-password
WEB_WORKERS=2
RUST_LOG=info,actix_web=info
