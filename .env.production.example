# Copy to .env.production and replace every CHANGE_ME value.
PUBLIC_URL=https://example.com
BIND_ADDRESS=127.0.0.1
PORT=8080
WEB_WORKERS=2
MONGODB_DATABASE=italy_developers
MONGO_ROOT_USERNAME=italy_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_USE_A_LONG_URL_SAFE_PASSWORD
# Generate a URL-safe value of at least 64 characters.
APP_SECRET_KEY=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS_000000000000000000000
RUST_LOG=info,actix_web=info
